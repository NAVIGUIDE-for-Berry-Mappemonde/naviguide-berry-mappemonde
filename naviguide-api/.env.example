# NAVIGUIDE API — Environment Variables Template
# Copy to .env and fill in your values (never commit .env to git)

# ── Copernicus Marine (existing) ─────────────────────────────────────────────
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# ── Groq API — Simulation Mode Agents (primary LLM) ──────────────────────────
# Required for the 4 AI agents (custom, guard, meteo, pirate)
GROQ_API_KEY=gsk_...

# Optional: override default model and token limit
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_MAX_TOKENS=1024

# ── OpenRouter — Automatic fallback on Groq 429 / quota exhaustion ────────────
# Cascade: Groq → nvidia/nemotron-3-ultra-550b-a55b:free → google/gemma-4-31b-it:free
# Leave empty to disable fallback (agents will return static content instead)
OPENROUTER_API_KEY=

# Optional: override fallback models
# OPENROUTER_MODEL_1=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL_2=google/gemma-4-31b-it:free

# ── StormGlass API — Agent Météo (optional) ───────────────────────────────────
# If not set, the meteo agent uses LLM training data only
# STORMGLASS_API_KEY=your_stormglass_key

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
